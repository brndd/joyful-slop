{
    "version": "2.0.0",
    "type": "shell",
    "command": "go",
    "options": {
        "cwd": "${workspaceFolder}",
    },
    "presentation": {
        "reveal": "never",
        "revealProblems": "onProblem",
    },
    "tasks": [
        {
            "label": "Build Project",
            "args": [
                "build",
                "-o",
                "build/",
                "./..."
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Test Project",
            "args": [
                "test",
                "./..."
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ],
}